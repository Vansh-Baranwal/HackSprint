# Python backend — git ignore rules
# =====================================
# Drop this file at HackSprint/.gitignore
# (sibling of api.py, main.py, models/)

# ── Node.js / frontend dependencies (added) ─────────────────────────────────────
node_modules/

# ── Wearable data (too large for Git, fetched at runtime via WEARABLE_DATA_URL) ─
data/
*.csv
*.parquet
*.feather

# ── Python runtime ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.spec

# ── Virtual environments ────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ── Environment variables (secrets) ────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example          # keep the example template committed

# ── Trained model artefacts (large binaries — use model registry instead) ──────
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
*.cbm                  # CatBoost
models/*.bin
models/*.json          # XGBoost serialised trees (can be > 100 MB)

# ── IDE / OS ────────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# ── Test / coverage artefacts ──────────────────────────────────────────────────
.coverage
.pytest_cache/
htmlcov/