# .env.local.example — Environment Variable Reference
# =====================================================
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. NEVER commit real credentials.
#
# For local development:
#   cp .env.local.example .env.local
#
# For Render deployment:
#   Set these in the Render dashboard > Environment tab (or render.yaml envVars)

# ── Data Source ────────────────────────────────────────────────────────────────
# Direct download URL for wearable_data.csv.
# Accepted sources:
#   Google Drive  : https://drive.google.com/uc?export=download&id=FILE_ID
#   Dropbox       : https://www.dropbox.com/s/FILE_ID/wearable_data.csv?dl=1
#   S3 (public)   : https://your-bucket.s3.region.amazonaws.com/wearable_data.csv
#   Supabase      : https://PROJECT.supabase.co/storage/v1/object/public/data/wearable_data.csv
WEARABLE_DATA_URL=https://your-direct-download-link.com/wearable_data.csv

# Local path where the downloaded file is cached (relative to project root)
WEARABLE_DATA_PATH=data/wearable_data.csv

# ── Streaming Configuration ────────────────────────────────────────────────────
# Number of CSV rows to process per streaming batch.
# Lower = less RAM, more network round-trips. Higher = faster, more RAM.
# Render free-tier: keep at 10000 (≈1.7 MB active at any moment).
CSV_CHUNK_SIZE=10000

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
